# Copy to analytics_agent/.env and fill in. Never commit the real .env.

# Required: the app refuses to start without these.
# Supabase Postgres connection string (Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
# Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# "production" makes the SUPABASE_S3_* vars below required at startup.
# Any other value (or unset) only logs a warning when they're missing.
APP_ENV=development

# Supabase Storage S3-compatible endpoint (Project Settings -> Storage -> S3 Connection).
# Used by GET /data/{dataset_id} to read only the requested page of a parquet file,
# and by profiling / version cleaning. Outside production, if any are missing,
# /data/{dataset_id} falls back to downloading the whole file, and profiling / cleaning will fail.
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=your-project-region
SUPABASE_S3_ACCESS_KEY_ID=your-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
